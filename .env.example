# --- AI ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key-here

# --- Auth (Auth.js / NextAuth v5) ---
# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# --- Database (Vercel Postgres) ---
# On Vercel: Project -> Storage -> Create Database -> Postgres -> Connect
# to this project. That automatically injects POSTGRES_URL (and friends)
# into your deployment's env vars — you don't need to set it manually there.
#
# For local development, copy the connection string Vercel shows you
# (or from any Postgres provider, e.g. Neon, Supabase) into this file:
POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require
